{
  "name": "vaccination-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first patient registry and vaccination scheduling portal for rural maternal and child health clinics",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"vite\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"shared/test/*.test.js\" \"server/test/*.test.js\"",
    "db:seed": "node --env-file-if-exists=.env server/cli.js seed",
    "db:reset": "node --env-file-if-exists=.env server/cli.js reset",
    "db:refresh": "node --env-file-if-exists=.env server/cli.js refresh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
