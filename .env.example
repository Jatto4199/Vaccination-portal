# Copy to .env for local use. On Vercel, set these in Project Settings -> Environment Variables.

# Required. Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# PostgreSQL connection string. Leave empty locally to use the embedded database
# (server/data/pgdata). On Vercel, adding a Neon database sets this automatically.
DATABASE_URL=

# Protects the daily cron endpoint (/api/cron/daily). Vercel Cron sends it automatically.
CRON_SECRET=

# Add demo clinics, accounts and patients to an empty database on first start.
# Defaults to true for the embedded database and false when DATABASE_URL is set.
SEED_DEMO_DATA=

# Passwords for the demo accounts (defaults: admin123 / password123).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
